# Template delle variabili del BACKEND (apps/api). Copia questo file in apps/api/.env e personalizza i valori:
#   cp apps/api/.env.example apps/api/.env
# L'API legge apps/api/.env con dotenv partendo dalla cartella del pacchetto (pnpm dev:api, pnpm ingest, pnpm test:db):
# un .env nella root del repository NON viene letto da nessuno. Il frontend ha il suo file: apps/web/.env.example.
# Nessun segreto reale deve mai essere committato: questo file contiene solo segnaposto.

# --- Database (apps/api) ---
# 5433 e non 5432: evita la collisione con un eventuale PostgreSQL nativo già installato.
DATABASE_URL=postgresql://tappafurba:tappafurba@localhost:5433/tappafurba

# --- API server (apps/api) ---
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# Dietro un reverse proxy (nginx, ecc.) metti il NUMERO di proxy fidati, di solito 1: altrimenti il rate limit vede sempre
# l'IP del proxy. NON usare `true`: si fiderebbe di tutto l'header X-Forwarded-For, che un client può falsificare per
# aggirare i limiti per IP. In locale lascia false.
TRUST_PROXY=false
# Segreto per `POST /ingest` (almeno 32 caratteri, `openssl rand -hex 32`). Vuoto = endpoint disattivato (consigliato:
# l'ingestione si lancia con `pnpm ingest` o da un timer). Se lo imposti: `Authorization: Bearer <segreto>`.
# INGEST_TOKEN=

# --- Ingestione MIMIT Osservaprezzi (apps/api) ---
# Valori di default già corretti: sovrascrivere solo per puntare a fixture/mirror diversi.
MIMIT_ANAGRAFICA_URL=https://www.mimit.gov.it/images/exportCSV/anagrafica_impianti_attivi.csv
MIMIT_PREZZI_URL=https://www.mimit.gov.it/images/exportCSV/prezzo_alle_8.csv

# --- Mapbox, lato server ---
# UN SOLO token, usato SOLO dal backend per Directions e Geocoding. Non va mai nel browser né in git.
# Crea un token SEGRETO (sk.…) dedicato sul tuo account Mapbox (Admin → Tokens → Create a token):
#   - Name: tappafurba-server
#   - Public scopes: nessuno serve (Directions e Geocoding non richiedono scope); se il modulo non lo permette, lasciali
#   - Secret scopes: spunta SOLO `SCOPES:LIST` (innocuo: elenca gli scope del token). Serve perché Mapbox genera un token sk.
#     solo se c'è almeno uno scope segreto; senza, il token è pk. Non spuntare altro (mai TOKENS:*, *:WRITE, *:DOWNLOAD)
#   - URL restrictions: NESSUNA (le chiamate partono dal server senza Referer e verrebbero bloccate)
# Mapbox mostra il token una sola volta: copialo qui subito. Non usare un token pubblico (pk.…): è pensato per il browser;
# in produzione (NODE_ENV=production) l'API rifiuta di avviarsi con un pk.
# Se lasciato vuoto l'API parte comunque, con geocoding "fixture" e routing "mock" (nessuna chiave necessaria).
MAPBOX_SERVER_TOKEN=
# Opzionali: forzano un provider anche in presenza del token. Valori: GEOCODING_PROVIDER=mapbox|fixture, ROUTING_PROVIDER=mapbox|mock
# GEOCODING_PROVIDER=
# ROUTING_PROVIDER=

# --- Prezzi in tempo reale (apps/api) ---
# Il file CSV MIMIT è indietro di 1-2 giorni: prima di ogni ricerca si aggiornano i riquadri del percorso
# dal sito ufficiale Osservaprezzi. Non è un'API pubblica documentata: vedi docs/ATTRIBUTION.md (note sulle fonti).
# 'off' = solo file giornaliero.
# LIVE_PRICES_PROVIDER=ospz
# LIVE_PRICES_BASE_URL=https://carburanti.mise.gov.it/ospzApi
# Identifica TappaFurba verso il ministero: aggiungi un tuo contatto.
# LIVE_PRICES_USER_AGENT=TappaFurba/0.1 (+tuo-contatto@esempio.it)
# Un riquadro aggiornato da meno di N minuti non viene richiesto di nuovo.
# LIVE_PRICES_TTL_MIN=60
# Tetto di chiamate al ministero per singola ricerca, attesa massima e chiamate simultanee (max 8).
# Il ministero risponde 429 se si esagera: non alzare senza motivo.
# LIVE_PRICES_MAX_TILES_PER_SEARCH=40
# LIVE_PRICES_DEADLINE_MS=10000
# LIVE_PRICES_CONCURRENCY=3

# --- Limiti a protezione della spesa Mapbox (apps/api) ---
# Kill switch sul contatore mensile delle chiamate Directions (free tier Mapbox: 100.000/mese, nessun tetto di spesa nativo).
# Oltre la soglia soft: niente verifica col routing reale, solo stima geometrica. Oltre la hard: la ricerca risponde 503.
DIRECTIONS_SOFT_LIMIT=80000
DIRECTIONS_HARD_LIMIT=98000
# Tetto mensile delle chiamate di Geocoding (autocomplete + reverse, tutti gli IP insieme): oltre, l'API smette di chiamare
# Mapbox e risponde 503. Il piano gratuito del Temporary Geocoding è di 100.000/mese: lascia il valore sotto.
GEOCODING_HARD_LIMIT=95000
# Richieste al minuto per IP.
SEARCH_RATE_LIMIT_PER_MIN=20
GEOCODE_RATE_LIMIT_PER_MIN=120
